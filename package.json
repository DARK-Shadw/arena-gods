{
  "name": "arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spectator-first AI gladiator arena prototype (Three.js + deterministic sim)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sim:test": "tsx tools/simtest.ts",
    "fx:check": "tsx tools/fxcheck.ts",
    "typecheck": "tsc --noEmit",
    "audio:build": "tsx tools/audio/build-sfx.ts",
    "audio:check": "tsx tools/audio/check.ts",
    "tts:gen": "node tools/tts/run.mjs",
    "arena:concept": "node tools/shots/concept.cjs",
    "arena:bake": "python -I tools/arena/bake.py",
    "arena:fetch": "node tools/arena/fetch_cc0.mjs",
    "arena:assets": "node tools/arena/build_assets.mjs",
    "arena:budget": "node tools/arena/check_budget.mjs",
    "arena:backdrop": "node tools/arena/build_backdrop.mjs",
    "arena:sky": "node tools/arena/build_sky.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.1",
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "playwright-core": "^1.57.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
}
